# ==============================================================================
# Supabase Configuration Template — Sorga Desa Belega
# ==============================================================================
# ⚠️ PENTING / SECURITY WARNING:
# Aplikasi ini TIDAK BOLEH di-deploy ke production tanpa mengisi VITE_SUPABASE_URL
# dan VITE_SUPABASE_ANON_KEY dengan kredensial project Supabase yang valid.
#
# Tidak ada fallback otentikasi hardcoded atau offline bypass di lingkungan production.
# Jika environment variables ini kosong/salah di production, seluruh akses login akan diblokir.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
